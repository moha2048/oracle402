# ---- wallets (run `npm run wallets`, paste output here). TESTNET ONLY. ----
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# ---- seller ----
SELLER_PORT=3000
FORECAST_PRICE=$0.001

# ---- agent ----
AGENT_PORT=3001
SELLER_URL=http://localhost:3000
AGENT_BUDGET_USDC=0.01
APPROVE_AFTER_FRACTION=0.5
MAX_PER_CALL_USDC=0.005
# Optional: enables the real LLM decision loop. Without it a scripted stand-in runs.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# ---- dev-only switches (leave unset for the real demo) ----
# MOCK_GEMINI=1   use built-in sample markets instead of calling Gemini
# MOCK_PAY=1      skip the paywall/payment entirely (ledger rows are flagged MOCK)
